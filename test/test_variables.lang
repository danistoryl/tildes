// Test Variables: let, let mut, pub, types
use System;

fun main() {
    // Immutable variables
    let boolean: bool = false
    let number: num = 123
    let realNumber: f64 = 12.34
    let string: str = "This is string"
    
    // Mutable variables
    let mut counter: num = 0
    counter = counter + 1
    
    // Public variables
    pub let global_val: str = "global"
    
    // Type casting
    let int_val: i32 = 42 as i32
    let float_val: f32 = 3.14 as f32
    
    print("Variables test passed!")
    print("Number: " + number.to_string())
    print("String: " + string)
    print("Counter: " + counter.to_string())
}
