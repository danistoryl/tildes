# Advanced FFI Test for FCL Language

print("=== Advanced FFI Test ===");

// Test 1: Struct handling
print("\n1. Struct Test:");
extern fun create_point(x: num, y: num) -> ptr from "libadvanced.so";
extern fun point_distance(p: ptr) -> num from "libadvanced.so";
extern fun modify_point(p: ptr, dx: num, dy: num) -> void from "libadvanced.so";
extern fun free_point(p: ptr) -> void from "libadvanced.so";

let p = create_point(10.0, 20.0);
print("  Created Point(10, 20)");
let dist = point_distance(p);
print("  Distance: " + dist.to_string());

modify_point(p, 5.0, 5.0);
print("  Modified Point by (5, 5)");

free_point(p);
print("  Point freed");

