// Test 3: Callbacks
print("\n3. Callback Test:");
extern fun register_callback(cb: fn(num) -> void) -> void from "libadvanced.so";
extern fun trigger_event(value: num) -> void from "libadvanced.so";

fun my_callback(val: num) {
    print("  Callback received: " + val.to_string());
}

register_callback(my_callback);
trigger_event(42);

// Test 4: Void* memory operations
print("\n4. Memory Buffer Test:");
extern fun allocate_buffer(size: num) -> ptr from "libadvanced.so";
extern fun write_to_buffer(buf: ptr, data: str, len: num) -> void from "libadvanced.so";
extern fun read_from_buffer(buf: ptr) -> str from "libadvanced.so";
extern fun free_buffer(buf: ptr) -> void from "libadvanced.so";

let buf = allocate_buffer(100);
print("  Allocated buffer (100 bytes)");
write_to_buffer(buf, "Hello FFI", 9);
let content = read_from_buffer(buf);
print("  Buffer content: " + content);
free_buffer(buf);
print("  Buffer freed");

