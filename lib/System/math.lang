// System Math Library
// Provides mathematical operations

pub fun abs(x: num) -> num {
    return builtin_abs(x);
}

pub fun sqrt(x: num) -> num {
    return builtin_sqrt(x);
}

pub fun pow(base: num, exp: num) -> num {
    return builtin_pow(base, exp);
}

pub fun min(a: num, b: num) -> num {
    if a < b {
        return a;
    }
    return b;
}

pub fun max(a: num, b: num) -> num {
    if a > b {
        return a;
    }
    return b;
}

pub fun floor(x: num) -> num {
    let result: num = int(x);
    return result;
}

pub fun ceil(x: num) -> num {
    let result: num = int(x);
    if x > result {
        return result + 1;
    }
    return result;
}

pub fun round(x: num) -> num {
    return floor(x + 0.5);
}
